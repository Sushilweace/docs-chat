# Copy to .env and fill in the values.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Which LLM answers questions: "anthropic", "gemini" or "groq". Set the matching key below.
LLM_PROVIDER=anthropic
LLM_MAX_TOKENS=1024

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Get a key at https://console.groq.com/keys (free tier available)
GROQ_API_KEY=
# Models differ per account; list yours with the snippet in the README.
GROQ_MODEL=qwen/qwen3.8-27b

# Comma-separated emails allowed to open the /admin panel. Empty = nobody.
ADMIN_EMAILS=

DATABASE_URL=sqlite:///./data/app.db
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150

TOP_K=5
# Cosine distance; chunks farther away than this are treated as irrelevant.
DISTANCE_THRESHOLD=0.8
HISTORY_MESSAGES=5

CHAT_RATE_LIMIT=10/minute
LOG_LEVEL=INFO
PRELOAD_EMBEDDINGS=true
